# Copy to terraform.tfvars and fill in real values. Never commit
# terraform.tfvars if it contains anything sensitive.

aws_region       = "us-east-1"
environment      = "prod"
project_name     = "dream-vacations"

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]

instance_type   = "t3.micro"
key_pair_name   = "dream-vacations-key" # must already exist in this AWS account/region
ssh_allowed_cidr = "203.0.113.10/32"    # replace with your own IP in production

domain_name = "" # e.g. "dreamvacations.example.com" - leave blank to skip Route 53
