# Copy this file to .env and adjust values before running docker compose.
# .env is git-ignored - never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dream_vacations
POSTGRES_PORT=5432

# --- Backend (Node/Express) ---
BACKEND_PORT=3001
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=dream_vacations
DATABASE_URL=postgres://postgres:${DB_PASSWORD}@db:5432/dream_vacations
COUNTRIES_API_BASE_URL=https://restcountries.com/v3.1

# --- Frontend (React, served by Nginx in its container) ---
FRONTEND_PORT=8080
REACT_APP_API_BASE_URL=/api
